# Copy to web/.env.local on the Hermes machine. Never commit the real file.

# Where job_os.py keeps your data (profile.json, database, drafts). Outside this repo is best.
JOB_OS_DIR=/home/you/job-os-data
# JOB_OS_PY=/home/you/product-infos/job_os.py
# PYTHON=python3

# Only these Tailscale logins get in (comma-separated). Empty = nobody.
ALLOWED_TAILSCALE_LOGINS=you@example.com
# The Serve URL, used by the CSRF Origin check.
DASHBOARD_ORIGIN=https://your-machine.your-tailnet.ts.net

# Where the dashboard listens. Loopback or a Unix socket only.
LISTEN=unix:/run/job-os/web.sock
SOCKET_MODE=660

# Hermes API server (stays on 127.0.0.1).
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Set these after the live chat-contract test:
# HERMES_CONTINUATION=conversation      # or previous_response_id
# HERMES_STOP_CANCELS=false             # true only if aborting really cancels the run

# Dev only (`npm run dev` on your PC, without Serve):
# JOB_OS_DEV_LOGIN=you@example.com
